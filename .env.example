APP_ENV=development
APP_NAME=Orqivo
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
# If you are running behind Docker/Nginx locally, use http://localhost:8080 instead.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set the URL for your database; for Compose, use the postgres service hostname.
DATABASE_URL=
# Generate independent random values for session and CSRF signing; never commit them.
SESSION_SECRET=
CSRF_SECRET=
MOCK_MODE=true
MOCK_FAILURE_RATE=0
MOCK_TIMEOUT_RATE=0
ANSIBLE_ENABLED=false
ANSIBLE_BINARY=/usr/local/bin/ansible-playbook
ANSIBLE_CONFIG=/opt/windows-automation/ansible/ansible.cfg
ANSIBLE_WORKING_DIRECTORY=/opt/windows-automation/ansible
ANSIBLE_JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=2
# Use the exact AD UPN assigned to the dedicated automation identity in production.
# Inject its password only through the protected Linux VM environment file/secret manager.
WINDOWS_USERNAME=
WINDOWS_PASSWORD=
WINDOWS_WINRM_PORT=5986
WINDOWS_WINRM_TRANSPORT=ntlm
WINDOWS_CERT_VALIDATION=
# Set the CA bundle path when using docker-compose.kerberos.yml.
WINDOWS_CA_CERTIFICATE_PATH=
# Test-only AD disable automation is off by default. Configure a registered
# development/test server before enabling it.
AD_ACCOUNT_STATE_TEST_MODE=false
AD_ACCOUNT_STATE_TEST_SERVER_NAME=
AD_ACCOUNT_STATE_TEST_ALLOW_HTTP=false
AD_DEMO_OU_DN=
# Required by docker-compose.kerberos.yml; host-side absolute file paths.
KRB5_CONFIG_FILE=
WINDOWS_CA_CERTIFICATE_FILE=
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
DEV_ADMIN_PASSWORD=
DEV_OPERATOR_PASSWORD=
DEV_VIEWER_PASSWORD=
# Optional Azure Entra ID SSO. Configure all values to enable the SSO button.
AZURE_SSO_TENANT_ID=
AZURE_SSO_CLIENT_ID=
AZURE_SSO_CLIENT_SECRET=
AZURE_SSO_REDIRECT_URI=https://portal.example.com/api/v1/auth/sso/callback
AZURE_SSO_ADMIN_GROUP_ID=
AZURE_SSO_OPERATOR_GROUP_ID=
AZURE_SSO_VIEWER_GROUP_ID=
POSTGRES_USER=portal
POSTGRES_PASSWORD=
POSTGRES_DB=windows_automation
