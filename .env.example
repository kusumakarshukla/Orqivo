# Development defaults. Configure sensitive values in Replit Secrets or a
# protected environment file on the Linux automation host. Never commit .env.
APP_ENV=development
APP_NAME=Windows Automation Portal
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://portal:REPLACE_WITH_LOCAL_DB_PASSWORD@localhost:5432/windows_automation
SESSION_SECRET=
CSRF_SECRET=
MOCK_MODE=true
MOCK_FAILURE_RATE=0
MOCK_TIMEOUT_RATE=0
ANSIBLE_ENABLED=false
ANSIBLE_BINARY=/usr/bin/ansible-playbook
ANSIBLE_CONFIG=/opt/windows-automation/ansible/ansible.cfg
ANSIBLE_WORKING_DIRECTORY=/opt/windows-automation/ansible
ANSIBLE_JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=2
WINDOWS_USERNAME=
WINDOWS_PASSWORD=
WINDOWS_WINRM_PORT=5986
WINDOWS_WINRM_TRANSPORT=ntlm
WINDOWS_CERT_VALIDATION=validate
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
DEV_ADMIN_PASSWORD=
DEV_OPERATOR_PASSWORD=
DEV_VIEWER_PASSWORD=
POSTGRES_USER=portal
POSTGRES_PASSWORD=
POSTGRES_DB=windows_automation
