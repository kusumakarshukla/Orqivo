[Unit]
Description=Orqivo Windows Automation API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=windows-automation
Group=windows-automation
WorkingDirectory=/opt/windows-automation/backend
EnvironmentFile=/etc/windows-automation.env
Environment=PYTHONPATH=/opt/windows-automation/backend
ExecStart=/opt/windows-automation/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/windows-automation/var

[Install]
WantedBy=multi-user.target
